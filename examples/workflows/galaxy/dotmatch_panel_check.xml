<tool id="dotmatch_panel_check" name="DotMatch panel check" version="0.1.0+galaxy0" profile="22.05" license="Apache-2.0">
    <description>certify barcode-panel assignment safety</description>
    <requirements>
        <requirement type="package" version="0.1.0">dotmatch</requirement>
    </requirements>
    <command detect_errors="exit_code"><![CDATA[
dotmatch panel check '$panel' \
  --k '$k' \
  --metric '$metric' \
  --out-dir panel_check

cp panel_check/panel_summary.json '$panel_summary'
cp panel_check/target_safety.tsv '$target_safety'
cp panel_check/collision_pairs.tsv '$collision_pairs'
cp panel_check/panel_report.html '$panel_report'
    ]]></command>
    <inputs>
        <param name="panel" type="data" format="tabular,csv,txt" label="Barcode panel" help="Table with id and sequence columns."/>
        <param name="k" type="integer" value="1" min="0" max="2" label="Correction radius"/>
        <param name="metric" type="select" label="Metric">
            <option value="hamming" selected="true">Hamming</option>
            <option value="levenshtein">Levenshtein</option>
        </param>
    </inputs>
    <outputs>
        <data name="panel_summary" format="json" label="${tool.name} on ${on_string}: panel summary"/>
        <data name="target_safety" format="tabular" label="${tool.name} on ${on_string}: target safety"/>
        <data name="collision_pairs" format="tabular" label="${tool.name} on ${on_string}: collision pairs"/>
        <data name="panel_report" format="html" label="${tool.name} on ${on_string}: report"/>
    </outputs>
    <tests>
        <test expect_num_outputs="4">
            <param name="panel" value="panel_barcodes.tsv"/>
            <param name="k" value="1"/>
            <param name="metric" value="hamming"/>
            <output name="panel_summary">
                <assert_contents>
                    <has_text text="&quot;status&quot;"/>
                    <has_text text="&quot;minimum_hamming_distance&quot;"/>
                </assert_contents>
            </output>
            <output name="target_safety">
                <assert_contents>
                    <has_text text="barcode_id"/>
                    <has_text text="BC001"/>
                </assert_contents>
            </output>
        </test>
    </tests>
    <help><![CDATA[
DotMatch panel check produces a machine-checkable barcode safety certificate
before correction-based demultiplexing is used.
    ]]></help>
    <citations>
        <citation type="bibtex"><![CDATA[
@software{dotmatch_2026,
  title = {DotMatch: Streaming Exact One-Edit Barcode and Guide Assignment Without Exhaustive Scanning},
  author = {O'Toole, Donncha},
  version = {0.1.0},
  url = {https://github.com/Dnncha/dotmatch}
}
        ]]></citation>
    </citations>
</tool>
