/*
 * Example nf-core style pipeline using DotMatch modules
 *
 * This demonstrates end-to-end use of the local module candidates.
 * For real use, replace with installed nf-core modules after upstreaming.
 */

params {
  // Example for CRISPR count
  input          = 'samplesheet.csv'  // or use the fixtures directly in main
  library        = '../../fixtures/crispr_library.csv'
  guide_start    = 0
  guide_length   = 4
  k              = 1
  metric         = 'hamming'

  // For assay
  assay_spec     = '../../fixtures/crispr_assay.toml'
  outdir         = 'results'
}

process {
  // Resource hints
  cpus   = { task.ext.cpus   ?: 2 }
  memory = { task.ext.memory ?: 4.GB }
}

profiles {
  standard {
    process.executor = 'local'
  }
  docker {
    docker.enabled = true
    // assumes the container from the modules
  }
}