* text=auto eol=lf

*.c text eol=lf
*.h text eol=lf
*.cpp text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.md text eol=lf
*.csv text eol=lf
*.tsv text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.svg text eol=lf

*.gz binary
*.zip binary
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary


# Audited evidence hashes refer to exact generated bytes, including CSV CRLF.
benchmarks/raw/*.csv -text whitespace=cr-at-eol
# Matplotlib path data intentionally includes spaces before line breaks.
benchmarks/figures/*.svg whitespace=-blank-at-eol
public/benchmarks/*.svg whitespace=-blank-at-eol
# Preserve the verbatim upstream license text.
packages/crisprworks-fit/licenses/*.txt whitespace=-blank-at-eol
