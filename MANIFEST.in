include LICENSE NOTICE README.md CITATION.cff CHANGELOG.md CONTRIBUTING.md SECURITY.md AGENTS.md BUILD_STATUS.md RELEASE_NOTES.md llms.txt roadmap.json release-files.json pyproject.toml MANIFEST.in .gitignore .gitattributes
recursive-include .github *.md *.yml *.yaml
recursive-include docs *.md *.json
recursive-include tests *.py *.json
recursive-include scripts *.py
recursive-include examples *.json *.fasta
